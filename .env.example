# Copy to .env to override. Every value shown is the default; none is a secret (all are local development placeholders).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only
LEDGER_DB_PASSWORD=local-dev-only-app
# Real CPU work per request (rounds of SHA-256). More rounds, lower capacity per instance.
WORK_ROUNDS=3000
# Empty: instances have no shared dependency. `make run` sets it for the pool experiments.
LEDGER_URL=
LEDGER_TIMEOUT_S=0.5
POOL_SIZE=20
POOL_TIMEOUT_S=0.4
HOLD_MS=10
LOG_LEVEL=INFO
# Load test durations. The lesson's real values are STEP_SECONDS=120 and SOAK_SECONDS=1800.
STEP_SECONDS=10
SOAK_SECONDS=120
# Host ports (all published on 127.0.0.1 only). Change one if something else on this machine uses it.
EDGE_PORT=47280
ENVOY_ADMIN_PORT=47281
APP_A1_PORT=47282
APP_A1_OPS_PORT=47283
LEDGER_OPS_PORT=47284
PROMETHEUS_PORT=47290
DB_PORT=47232
